  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,jsx,json,ts,tsx,yaml,md}": [
      "eslint --fix"
    ],
    "*.{css,scss,html}": [
      "eslint",
      "stylelint --fix"
